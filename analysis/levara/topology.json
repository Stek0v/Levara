  "pkg/llm/mock"
 ],
 "observations": [
  "internal/http is the god-hub: nearly every domain imports or is dispatched through it; its own methods carry the hottest fan-outs (mcpHandler.Q 564).",
  "cmd/server/main.go hand-wires every subsystem (betweenness 133, highest in app code) \u2014 single point of wiring failure; runreg exists but is not the sole path.",
  "Recall path depends on the EXTERNAL embed server :9101 \u2014 prod telemetry shows p99/p50 = ~1000x variance when it is slow/down (documented incident class).",
  "Data writes fan out to BOTH SQLite and PostgreSQL through pkg/sqlcompat \u2014 any storage refactor must keep the dual-DB contract tests green.",
  "gRPC v1 (internal/grpc/service.go) coexists with v2 (service_v2.go); v1 ListCollections/HasCollection are import-graph dead \u2014 candidate retirement.",
  "Symbol-level dead candidates inside internal/http/mcp*.go are suppressed from deadEnds: the MCP dispatch table reaches handlers dynamically; verify against ToolDescriptors before deleting (see ASSESSMENT.md #3).",
  "Datastore read/write edges are domain-role heuristics (WRITE_DOMAINS/READ_DOMAINS), not per-call-site facts; treat as orientation, not proof."
 ],
 "flows": [
  {
   "name": "Agent saves and later recalls a memory",
   "persona": "AI assistant using Levara over MCP (Claude, Codex, ZCode)",
   "description": "An agent stores a durable decision in one session and retrieves it in a later session.",
   "steps": [
    {
     "label": "Agent calls save_memory tool",
     "nodes": [
      "pkg/mcp",
      "internal/http"
     ]
    },
    {
     "label": "Memory written to hall + WAL",
     "nodes": [
      "pkg/memoryhall",
      "internal/store"
     ]
    },
    {
     "label": "Text embedded (external server)",
     "nodes": [
      "pkg/embed"
     ]
    },
    {
     "label": "Vector stored in collection",
     "nodes": [
      "pkg/vectorstore",
      "ds:hnsw"
     ]
    },
    {
     "label": "Later: recall_memory query",
     "nodes": [
      "pkg/mcp",
      "internal/http"
     ]
    },
    {
     "label": "Hybrid search + rerank",
     "nodes": [
      "pkg/bm25",
      "pkg/rerank",
      "pkg/vectorstore"
     ]
    },
    {
     "label": "Ranked memories returned",
     "nodes": [
      "pkg/memoryindex"
     ]
    }
   ]
  },
  {
   "name": "Engineer ingests a repository and explores the knowledge graph",
   "persona": "Knowledge worker / onboarding engineer",
   "description": "Someone points Levara at a git repo, lets it extract entities and edges, then queries who-did-what over time.",
   "steps": [
    {
     "label": "Ingest documents from git",
     "nodes": [
      "pkg/ingest",
      "pkg/git"
     ]
    },
    {
     "label": "Chunk + classify",
     "nodes": [
      "pkg/chunker",
      "pkg/classify"
     ]
    },
    {
     "label": "LLM extracts entities/edges",
     "nodes": [
      "pkg/llm",
      "pkg/structuredextract"
     ]
    },
    {
     "label": "Graph persisted with temporal validity",
     "nodes": [
      "pkg/orchestrator",
      "pkg/temporal",
      "pkg/graphdb"
     ]
    },
    {
     "label": "User queries entities / communities",
     "nodes": [
      "internal/http",
      "pkg/community"
     ]
    }
   ]
  },
  {
   "name": "Operator backs up and restores production",
   "persona": "On-call operator (Mac/Pi instances)",
   "description": "Nightly or pre-migration snapshot of all collections with isolated restore verification.",
   "steps": [
    {
     "label": "Run levara-backup verified",
     "nodes": [
      "cmd/backup",
      "pkg/backup"
     ]
    },
    {
     "label": "Snapshot WAL + collections",
     "nodes": [
      "internal/store",
      "pkg/storage"
     ]
    },
    {
     "label": "Restore into isolated copy",
     "nodes": [
      "pkg/backup",
      "pkg/storage"
     ]
    },
    {
     "label": "Verification passes, archive kept",
     "nodes": [
      "cmd/backup"
     ]
    }
   ]
  }
 ]
